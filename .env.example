# ================================================================
# Real Freelance Jobs - Environment Configuration Template
# Copy this file to .env and configure your secret credentials.
# NEVER commit .env to version control!
# ================================================================

# --- Telegram Bot Settings ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=AAGcVuWOGWm9I4Ug3-OqCeVxU-zx_aBPxCM

# Bot username without @ symbol
BOT_USERNAME=RealFreelanceJobsBot

# Comma-separated list of Telegram User IDs granted full administrator privileges
# e.g., 123456789,987654321
ADMIN_IDS=123456789

# Telegram Group / Channel ID for verified job broadcasts
# Must start with -100 for supergroups/channels (e.g., -1001234567890)
TELEGRAM_GROUP_ID=-1001234567890

# Group title / name
TELEGRAM_GROUP_NAME=Verified Freelance Joba


# --- Database Configuration ---
# Default for local development: SQLite with async support
DATABASE_URL=sqlite+aiosqlite:///./freelance_jobs.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/freelance_jobs


# --- AI Scam Analyzer Settings ---
# Supports Google Gemini or OpenAI-compatible endpoints
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-flash
# Alternative OpenAI settings:
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini


# --- Web Server & Health Check ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
